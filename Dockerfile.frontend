FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
# Copy only build inputs; never include local environment files.
COPY frontend/index.html frontend/vite.config.ts frontend/tsconfig*.json frontend/tailwind.config.ts frontend/postcss.config.js ./
COPY frontend/public ./public
COPY frontend/src ./src
ENV VITE_API_URL=""
RUN npm run build

FROM nginx:stable-alpine
COPY deploy/frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
