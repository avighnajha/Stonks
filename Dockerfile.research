# syntax=docker/dockerfile:1.4
FROM node:22-bookworm-slim AS exchange
WORKDIR /opt/exchange/services/trading_service
COPY services/trading_service/package*.json ./
RUN npm ci
COPY services/trading_service/ ./
RUN npm run build && npm prune --omit=dev

FROM python:3.12-slim-bookworm
COPY --from=exchange /usr/local/bin/node /usr/local/bin/node
COPY --from=exchange /opt/exchange/services/trading_service/dist /opt/exchange/services/trading_service/dist
COPY --from=exchange /opt/exchange/services/trading_service/node_modules /opt/exchange/services/trading_service/node_modules
WORKDIR /opt/simulation
COPY --from=simulation . .
RUN useradd --create-home worker && chown -R worker:worker /opt/simulation
USER worker
ENV PYTHONUNBUFFERED=1
CMD ["python", "-m", "stonks_sim.worker"]
